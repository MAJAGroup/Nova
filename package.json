{
  "name": "nova-browser",
  "version": "0.2.0",
  "private": true,
  "description": "Nova: a Chromium desktop browser with a built-in AI assistant.",
  "desktopName": "edu.buffalo.nova.desktop",
  "main": "desktop-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "appimage": "bash ./build-appimage.sh",
    "docs:capture": "node scripts/capture-readme.cjs",
    "test:history": "node --test tests/history*.test.cjs",
    "test:address": "node --test tests/address*.test.cjs",
    "test:newtab": "node --test tests/newtab*.test.cjs",
    "test:agent": "node --test tests/agent*.test.cjs tests/wake-*.test.cjs",
    "test:suggestions": "node --test tests/suggestions*.test.cjs",
    "test:bookmarks": "node --test tests/bookmarks*.test.cjs",
    "test:resources": "node --test tests/resources*.test.cjs",
    "test:branding": "node --test tests/profile-migration.test.cjs tests/linux-desktop.test.cjs tests/nova-desktop.test.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "edu.buffalo.nova",
    "productName": "Nova",
    "files": [
      "desktop-main.js",
      "desktop-preload.js",
      "assistant-handle-preload.js",
      "tab-groups.js",
      "ai-grouping.js",
      "ai-agent.js",
      "linux-desktop.js",
      "profile-migration.js",
      "tab-resources.js",
      "tab-resources-view.js",
      "tab-resources-preload.js",
      "assets/**/*",
      "ui/**/*",
      "vendor/porcupine/**/*",
      "README.md",
      "history-store.js",
      "bookmark-store.js",
      "reading-list-store.js",
      "connection-security.js",
      "search-suggestions.cjs",
      "search-preload.js",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "controls/OrbitControls.js",
          "renderers/CSS2DRenderer.js"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "category": "Network;WebBrowser;"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@picovoice/porcupine-web": "4.0.1",
    "three": "0.186.1"
  },
  "productName": "Nova"
}
