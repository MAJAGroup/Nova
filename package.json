{
  "name": "orbit-spatial-browser",
  "version": "0.2.0",
  "private": true,
  "description": "A Chromium desktop browser with a built-in AI assistant.",
  "main": "desktop-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "edu.buffalo.orbit",
    "productName": "ORBIT",
    "files": [
      "desktop-main.js",
      "desktop-preload.js",
      "tab-groups.js",
      "ai-grouping.js",
      "ui/**/*",
      "README.md"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network;WebBrowser;"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "three": "0.186.1"
  }
}
