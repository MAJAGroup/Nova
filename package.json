{
  "name": "orbit-spatial-browser",
  "version": "0.2.0",
  "private": true,
  "description": "A Chromium desktop browser with a built-in AI assistant.",
  "main": "desktop-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test:history": "node --test tests/history*.test.cjs",
    "test:address": "node --test tests/address*.test.cjs",
    "test:newtab": "node --test tests/newtab*.test.cjs",
    "test:suggestions": "node --test tests/suggestions*.test.cjs",
    "test:bookmarks": "node --test tests/bookmarks*.test.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "edu.buffalo.orbit",
    "productName": "ORBIT",
    "files": [
      "desktop-main.js",
      "desktop-preload.js",
      "assistant-handle-preload.js",
      "tab-groups.js",
      "ai-grouping.js",
      "ui/**/*",
      "README.md",
      "history-store.js",
      "bookmark-store.js",
      "connection-security.js",
      "search-suggestions.cjs",
      "search-preload.js",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "controls/OrbitControls.js",
          "renderers/CSS2DRenderer.js"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network;WebBrowser;"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "three": "0.186.1"
  }
}
