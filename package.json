{
  "name": "orbit-spatial-browser",
  "version": "0.3.1",
  "private": true,
  "description": "A Chromium desktop browser with a built-in AI assistant.",
  "main": "desktop-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:run:appimage": "bash scripts/build-and-run-appimage.sh",
    "test": "node --test tests/history.test.cjs",
    "test:desktop": "node --test tests/history-desktop.test.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "edu.buffalo.orbit",
    "productName": "ORBIT",
    "files": [
      "desktop-main.js",
      "desktop-preload.js",
      "tab-groups.js",
      "ai-grouping.js",
      "ui/**/*",
      "README.md",
      "history-store.js",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "controls/OrbitControls.js",
          "renderers/CSS2DRenderer.js"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network;WebBrowser;"
    }
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
