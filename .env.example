# Local entry point. Terminate HTTPS at a reverse proxy for remote use.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
DATA_DIR=./data
BRAND_NAME=Cosmic
REGISTRATION_DISABLED=false
# Chromium sandbox is ON. Disabling it is for trusted local fixtures only.
CHROMIUM_SANDBOX=true
MAX_TABS=12
MAX_CONTEXTS=8
IDLE_TIMEOUT_MS=900000
# Explicit admin exception, exact host:port pairs. Empty blocks all internal networks.
ALLOW_INTERNAL_HOSTS=
# Optional AI: page contents are sent only after per-task disclosure and consent.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# For Ollama: AI_PROVIDER=ollama and AI_BASE_URL=http://127.0.0.1:11434
